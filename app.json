{
  "expo": {
    "name": "flust",
    "slug": "flust",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flust",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111116",
    "ios": {
      "bundleIdentifier": "org.fnyxgroup.flust",
      "infoPlist": {
        "NSFaceIDUsageDescription": "flust uses Face ID to keep your space private."
      }
    },
    "android": {
      "package": "org.fnyxgroup.flust",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#111116",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111116",
          "image": "./assets/brand/flust-lockup.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/brand/flust-symbol.png",
            "imageWidth": 96
          }
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "50f57776-c6c8-4194-9dd5-c5a0e74d24f8"
      }
    },
    "locales": {
      "en": "./assets/native-strings/en.json",
      "fr": "./assets/native-strings/fr.json"
    }
  }
}
